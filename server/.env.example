# Salin file ini menjadi .env lalu isi nilainya.

# Port yang dipakai aplikasi (panel akan meneruskan domain Anda ke port ini)
PORT=3000
# 127.0.0.1 = hanya bisa diakses lewat reverse proxy panel (disarankan)
HOST=127.0.0.1

# Database MySQL / MariaDB (buat dulu database + user-nya di panel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pembukuan
DB_USER=pembukuan
DB_PASSWORD=ganti-dengan-password-database
# Khusus cPanel/sebagian panel: isi path socket MySQL dan kosongkan DB_HOST
# DB_SOCKET=/var/lib/mysql/mysql.sock

# Kunci rahasia untuk sesi login. WAJIB diganti, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kode untuk membuat akun admin pertama lewat browser. Kosongkan setelah admin dibuat.
SETUP_TOKEN=

# Lama sesi login (hari)
SESSION_DAYS=14

# Buku yang dibuka di alamat utama (biarkan sundaram).
DEFAULT_BOOK=sundaram

# Jika aplikasi dipasang di sub-folder, misal https://domain.com/akunting, isi: /akunting
BASE_PATH=

# Cookie hanya lewat HTTPS. auto = ikuti HTTPS dari reverse proxy; true/false untuk memaksa.
COOKIE_SECURE=auto
